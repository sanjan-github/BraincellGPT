# Copy this file to .env and fill in only the providers you use.
# Never commit .env or share real API keys.
# A key entered in the browser overrides the matching environment key.
# Leave the browser API-key field empty to use the environment key.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional provider credentials/models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
XAI_API_KEY=
XAI_MODEL=grok-3-mini
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
ANTHROPIC_API_KEY=

# Optional Azure OpenAI v1 endpoint. The deployment name is sent as "model".
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional custom OpenAI-compatible API.
# Base URL should normally end in /v1, not /chat/completions.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

PORT=8000
